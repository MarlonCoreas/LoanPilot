{
  "name": "loanpilot",
  "version": "0.1.0",
  "description": "Herramientas bilingües de préstamos, liquidaciones laborales y retenciones salariales para El Salvador.",
  "license": "MIT",
  "homepage": "https://loanpilot.marloncoreas.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarlonCoreas/LoanPilot.git"
  },
  "bugs": "https://github.com/MarlonCoreas/LoanPilot/issues",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "package": "bash scripts/package-release.sh",
    "og": "node scripts/og-image.mjs",
    "test": "npm run build && node --test",
    "check:rules": "node scripts/check-rules.mjs",
    "inventory": "node scripts/inventory.mjs",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  },
  "type": "module"
}
