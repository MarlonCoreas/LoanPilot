# Configuración opcional para servidores Apache o compatibles (LiteSpeed).
# Se ignora sin efectos en cualquier otro servidor estático.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  # frame-ancestors sólo funciona como cabecera, no como <meta>; el resto de la
  # política de seguridad viaja dentro de index.html.
  Header always set Content-Security-Policy "frame-ancestors 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Los assets llevan un hash en el nombre: cambian de nombre al cambiar de
  # contenido, así que pueden cachearse indefinidamente.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "immutable"
  </FilesMatch>

  # index.html no lleva hash: debe revalidarse para que un despliegue nuevo
  # llegue al usuario de inmediato.
  <FilesMatch "\.(html)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(svg|ico|png|jpg|webp)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>
</IfModule>

# Evita listados de directorio si el servidor los trae activados.
Options -Indexes

# Página de error propia. El archivo lo genera el build; sin esta línea el
# alojamiento muestra la suya, que no se parece en nada al sitio.
ErrorDocument 404 /404.html
